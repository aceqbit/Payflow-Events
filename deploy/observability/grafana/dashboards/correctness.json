{
  "uid": "correctness",
  "title": "Correctness",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "payflow"
  ],
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "run_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values(payflow_events_processed_total, run_id)",
          "refId": "v_run_id"
        }
      },
      {
        "name": "scenario",
        "label": "scenario",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values(payflow_verifier_lost_events, scenario)",
          "refId": "v_scenario"
        }
      },
      {
        "name": "relay",
        "label": "relay",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values(payflow_events_e2e_latency_seconds_count, relay)",
          "refId": "v_relay"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Generator and chaos events",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(payflow_generator_sent_total[1m]) > 0 or changes(payflow_verifier_last_run_timestamp_seconds[1m]) > 0"
      },
      {
        "name": "Chaos annotations",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "type": "tags",
          "tags": [
            "chaos"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Lost",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id, relay) (payflow_verifier_lost_events{run_id=~\"$run_id\"})",
          "legendFormat": "{{run_id}} {{relay}}"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
